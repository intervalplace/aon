AON_PORT=8787
AON_P2P_PORT=9000
AON_PEER_KEY_PATH=./data/peer.key
AON_BOOTSTRAP=
AON_DATA_DIR=data
AON_WS=true
AON_WS_PORT=8788
AON_WS_PEERS=
AON_LORA_PORT=
AON_BT=false
AON_RNS=false
AON_MAX_PEERS=50

# Public address(es) other nodes should dial, comma-separated, e.g.
# /dns4/node1.example.org/tcp/9000 (needed when the machine's own interface
# IPs aren't publicly reachable)
AON_ANNOUNCE=
# Shown on the explorer's "Join the network" card (defaults to AON_BOOTSTRAP)
AON_PUBLIC_BOOTNODES=
# Display name for this node in the explorer
AON_NODE_NAME=
# Serve the web explorer at / (default true)
AON_EXPLORER=true
# Namespaces the explorer lists by default; objects in other namespaces are
# one click away, so junk namespaces don't bury real activity
AON_EXPLORER_NAMESPACES=aon:evm-spot,aon:csd-usdc
# Allow remote callers to use POST /v1/p2p/* (dial, sync, push...). Default: local only.
AON_ADMIN_OPEN=false
# Log every HTTP request (default: warnings only)
AON_LOG_REQUESTS=false
